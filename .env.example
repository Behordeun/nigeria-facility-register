# Superset deployment secrets. Copy this file to .env beside docker-compose.yml
# and replace every value below with a real one before `docker compose up`.
# The compose file requires SUPERSET_SECRET_KEY, SUPERSET_ADMIN_PASSWORD and
# SUPERSET_DB_PASSWORD, so the stack refuses to start until they are set. .env is gitignored; never
# commit real values.

# Flask secret key for signing sessions. Generate one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=

# First admin login. The username is not sensitive; the password is.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=

# Password for Superset's metadata database (the superset-db Postgres service).
# Postgres sets it when its volume is first created; changing it later needs the
# same change inside Postgres (ALTER USER), or the superset_db volume recreated.
SUPERSET_DB_PASSWORD=

# Optional Mapbox public token (pk...) for the deck.gl basemap tiles. Without it
# the map background does not load; non-map charts are unaffected. Leave empty to
# run without a basemap.
MAPBOX_API_KEY=
